<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- camera + live stamp -->
        <FrameLayout
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.camera.view.PreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.assamconverter.geocam.StampView
                android:id="@+id/stamp"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:id="@+id/flash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="#FFFFFF" />

            <!-- top bar -->
            <LinearLayout
                android:id="@+id/topbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingTop="10dp"
                android:paddingRight="12dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/gps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill"
                    android:drawablePadding="6dp"
                    android:paddingLeft="12dp"
                    android:paddingTop="7dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="7dp"
                    android:text="Waiting for GPS…"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/bTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/pill"
                    android:gravity="center"
                    android:minWidth="44dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="⏱ Off"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/bGrid"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/round_dark"
                    android:contentDescription="Grid lines"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_grid" />

                <ImageButton
                    android:id="@+id/bTorch"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/round_dark"
                    android:contentDescription="Flashlight"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_flash"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/bSet"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/round_dark"
                    android:contentDescription="Settings"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>

            <TextView
                android:id="@+id/note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="66dp"
                android:background="@drawable/pill"
                android:ellipsize="end"
                android:maxWidth="320dp"
                android:paddingLeft="14dp"
                android:paddingTop="7dp"
                android:paddingRight="14dp"
                android:paddingBottom="7dp"
                android:singleLine="true"
                android:text="✎ Add note"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/rec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="108dp"
                android:background="@drawable/pill"
                android:backgroundTint="#FF3B30"
                android:paddingLeft="14dp"
                android:paddingTop="6dp"
                android:paddingRight="14dp"
                android:paddingBottom="6dp"
                android:text="● 00:00"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:shadowColor="#AA000000"
                android:shadowRadius="20"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="120sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- permissions / errors -->
            <LinearLayout
                android:id="@+id/perm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_pin"
                    android:tint="#FF6A35" />

                <TextView
                    android:id="@+id/permTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="Allow camera &amp; location"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/permText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="GeoTag Camera needs the camera to take photos and your location for the GPS stamp."
                    android:textColor="#AAA196"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/permBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginTop="22dp"
                    android:paddingLeft="28dp"
                    android:paddingRight="28dp"
                    android:text="Allow"
                    android:textSize="16sp"
                    app:backgroundTint="#E0561F"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />
            </LinearLayout>
        </FrameLayout>

        <!-- bottom controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000000"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="10dp"
            android:paddingRight="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/zoomRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <SeekBar
                    android:id="@+id/zoom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100" />

                <TextView
                    android:id="@+id/zoomVal"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1.0×"
                    android:textColor="#FFB020"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="PHOTO"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="VIDEO"
                    android:textColor="#AAA196"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="80dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="left|center_vertical">

                    <ImageView
                        android:id="@+id/thumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/thumb_bg"
                        android:contentDescription="Photos"
                        android:padding="2dp"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/shutter"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shutter"
                    android:contentDescription="Take photo" />

                <ImageButton
                    android:id="@+id/bFlip"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="right|center_vertical"
                    android:background="@drawable/round_dark"
                    android:contentDescription="Switch camera"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_flip" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
